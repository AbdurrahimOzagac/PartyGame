  m_Name: IceLoop
  m_EditorClassIdentifier: ShooterParty.Runtime::ShooterParty.MiniGameDefinition
  id: ice_loop
  displayName: Ice Loop
  tagline: Bumper cars on ice. Most checkpoints wins.
  howToPlay:
  - Race round the loop for 2 minutes. Every checkpoint you pass is a point, and
    the loop repeats.
  - 'The ice is slippery: brake early for bends. Dash (Shift) on the straights.'
  - Bump rivals and spit at them to send them into the water. A swim restarts you
    at your last checkpoint.
  controlsHint: "WASD move \xB7 Mouse aim \xB7 Hold click to spit \xB7 Shift dash"
